<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:orientation="vertical"
    android:padding="12dp"
    android:gravity="center_horizontal">

    <!-- Copertina Libro Grande e Centrata in Alto -->
    <ImageView
        android:id="@+id/widget_book_cover"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:src="@drawable/ic_book_placeholder"
        android:contentDescription="Copertina Libro"
        android:layout_marginBottom="8dp" />

    <!-- Riga Badge & Prezzo Centrata -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/widget_book_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge"
            android:paddingHorizontal="7dp"
            android:paddingVertical="2dp"
            android:text="✨ Novità"
            android:textColor="#38BDF8"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_book_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_badge"
            android:paddingHorizontal="7dp"
            android:paddingVertical="2dp"
            android:text="€ 18,50"
            android:textColor="#34D399"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Titolo del Libro (Centrato) -->
    <TextView
        android:id="@+id/widget_book_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:text="Titolo del Libro"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="2dp" />

    <!-- Autore (Centrato) -->
    <TextView
        android:id="@+id/widget_book_author"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="Autore del Libro"
        android:textColor="#94A3B8"
        android:textSize="11sp"
        android:layout_marginBottom="8dp" />

    <!-- Barra Controlli Centrata in Basso -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_gravity="center_horizontal">

        <ImageButton
            android:id="@+id/widget_btn_prev"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_widget_btn"
            android:src="@drawable/ic_prev"
            android:padding="5dp"
            android:contentDescription="Precedente" />

        <ImageButton
            android:id="@+id/widget_btn_goodreads"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_widget_btn"
            android:src="@drawable/ic_goodreads"
            android:padding="6dp"
            android:contentDescription="Goodreads" />

        <ImageButton
            android:id="@+id/widget_btn_amazon"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_widget_btn"
            android:src="@drawable/ic_amazon"
            android:padding="6dp"
            android:contentDescription="Store" />

        <ImageButton
            android:id="@+id/widget_btn_sync"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_widget_btn"
            android:src="@drawable/ic_sync"
            android:padding="6dp"
            android:contentDescription="Sincronizza" />

        <ImageButton
            android:id="@+id/widget_btn_next"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_widget_btn"
            android:src="@drawable/ic_next"
            android:padding="5dp"
            android:contentDescription="Successivo" />
    </LinearLayout>

</LinearLayout>
